// Local development schema — mirrors prisma/schema.prisma but targets SQLite
// so `npm run dev` works with zero local setup. Keep models in sync with the
// production schema (prisma/schema.prisma, which targets Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One saved cart drawer configuration. A shop can keep any number of
// drafts, but at most one config is PUBLISHED at a time — publishing one
// demotes the rest (enforced in app/models/cart-config.server.js, not by a
// constraint). The storefront proxy serves only the PUBLISHED config.
// `id` is the stable key future analytics events will reference.
model CartConfig {
  id        String   @id @default(cuid())
  shop      String
  name      String
  status    String   @default("DRAFT") // DRAFT | PUBLISHED
  settings  String   // JSON blob; shape defined by DEFAULT_SETTINGS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, status])
}
