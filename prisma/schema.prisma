// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One saved cart drawer configuration. A shop can keep any number of
// drafts, but at most one config is PUBLISHED at a time — publishing one
// demotes the rest (enforced in app/models/cart-config.server.js, not by a
// constraint). The storefront proxy serves only the PUBLISHED config.
// `id` is the stable key future analytics events will reference.
model CartConfig {
  id        String   @id @default(cuid())
  shop      String
  name      String
  status    String   @default("DRAFT") // DRAFT | PUBLISHED
  settings  String   // JSON blob; shape defined by DEFAULT_SETTINGS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, status])
}
